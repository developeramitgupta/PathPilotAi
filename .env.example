# Clerk — required in connected environments
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# Supabase — publishable key is safe for the browser; never expose the secret key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Drizzle — transaction pooler for runtime, session/direct pooler for migrations
DATABASE_URL=
DIRECT_URL=

# AI providers — added to the LangGraph-ready adapter in Milestone 2
OPENAI_API_KEY=
AI_MODEL_STRONG=
AI_MODEL_FAST=

# Official data ingestion. Keep these server-only; all imports enter admin review
# before student-visible publication.
DATA_GOV_API_KEY=
DATA_GOV_AISHE_RESOURCE_ID=

# Optional public GitHub REST requests work without this value. Add a narrowly
# scoped token only if rate limits require it; never request private-repository scope.
GITHUB_PUBLIC_API_TOKEN=

# Signed-resume upload configuration (Supabase Storage bucket: resumes).
RESUME_UPLOAD_MAX_BYTES=5242880
